<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="io.github.kk01001.postgres.examples.mapper.DemoUserMapper">

    <resultMap id="DemoUserMap" type="io.github.kk01001.postgres.examples.entity.DemoUser">
        <id property="id" column="id"/>
        <result property="username" column="username"/>
        <result property="email" column="email"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <insert id="insert" parameterType="io.github.kk01001.postgres.examples.entity.DemoUser">
        <selectKey keyProperty="id" resultType="long" order="BEFORE">
            SELECT nextval('demo_user_id_seq')
        </selectKey>
        INSERT INTO demo_user(id, username, email)
        VALUES (#{id}, #{username}, #{email})
    </insert>

    <select id="selectById" resultMap="DemoUserMap">
        SELECT id, username, email, created_at
        FROM demo_user
        WHERE id = #{id}
    </select>

    <update id="updateById" parameterType="io.github.kk01001.postgres.examples.entity.DemoUser">
        UPDATE demo_user
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="email != null and email != ''">
                email = #{email},
            </if>
        </set>
        WHERE id = #{id}
    </update>

    <delete id="deleteById">
        DELETE FROM demo_user WHERE id = #{id}
    </delete>

    <select id="count" resultType="long">
        SELECT COUNT(1)
        FROM demo_user
        <where>
            <if test="keyword != null and keyword != ''">
                (username ILIKE '%' || #{keyword} || '%' OR email ILIKE '%' || #{keyword} || '%')
            </if>
        </where>
    </select>

    <select id="page" resultMap="DemoUserMap">
        SELECT id, username, email, created_at
        FROM demo_user
        <where>
            <if test="keyword != null and keyword != ''">
                (username ILIKE '%' || #{keyword} || '%' OR email ILIKE '%' || #{keyword} || '%')
            </if>
        </where>
        ORDER BY id DESC
        LIMIT #{limit} OFFSET #{offset}
    </select>

</mapper>